{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Emit config for the publishable package (tambor-y9d.1). Strict flags
    // are inherited untouched; the only additions are emit-side:
    // rewriteRelativeImportExtensions turns the .ts specifiers that
    // allowImportingTsExtensions permits in source into .js/.d.ts
    // specifiers that survive plain tsc emit (DESIGN sub-decision recorded
    // in openspec/changes/add-distribution-packaging/design.md).
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "rewriteRelativeImportExtensions": true,
    "types": []
  },
  "include": ["src/**/*.ts"],
  // the service worker is a demo-shell artifact (demo-dist/sw.js via
  // scripts/build-spa.mjs) — the npm emit must not carry a second copy;
  // same for the docs site (add-docs-site): it is a docs artifact
  // (demo-dist/docs), and its generated content modules (D2: build-time
  // data under src/docs/content/generated/, gitignored) never exist in
  // a fresh checkout — so the shell that imports them cannot compile
  // there (CI's packaging contracts build the package from a clean
  // tree). Their embedded corpus prose would also leak the word "any"
  // into the p_no_any declarations scan.
  "exclude": ["src/spa/sw.ts", "src/docs/**"]
}
