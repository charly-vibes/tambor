
# dulce-de-leche — data files (do not commit)
.ddl/**/*.db
.ddl/**/store/
.ddl/install-log.json
.ddl/doctor-cache.json
.ddl/compatibility-cache.json

# tool stores / caches (data, not source)
.testaruda/
.pretender/
node_modules/
target/
dist/
# turu workspace — session notes are tracked; .whisper/private/ is
# machine-specific knowledge, never pushed (git history is forever)
.whisper/private/

# Beads / Dolt files (added by bd init)
# Git is the sync mechanism: .beads/issues.jsonl is committed (export.auto
# in .beads/config.yaml keeps it fresh). The embedded Dolt DB and runtime
# state are machine-local — ignored inside .beads/.gitignore. The global
# ~/.gitignore excludes .beads/ wholesale, which would make the tracked
# files unversionable (a parent dir excluded cannot be un-ignored); the
# negation below re-includes the directory, and .beads/.gitignore then
# ignores the machine-local state inside it.
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
.beads/
!.beads/
.beads/*.backup
.worktrees/

# devenv.sh state (see devenv.nix)
.devenv/
.devenv.flake.nix
.direnv/
.gate-timing.log

# vitest default json-reporter output dir (vitest 5 writes it even when
# the reporter is CLI-requested; tambor routes json via tools/vitest-runner.sh)
.vitest/

# generated AI docs (tools/gen_ai_docs.py output — deployed, not committed)
ai/
# compiled CLJS probe output (squint/cherry CLI artifacts) — regenerate with
# npx squint compile experiments/<f>.cljs / npx cherry compile <f>.cljs
experiments/real-*.mjs
experiments/real-macro-defs.mjs
experiments/cljs-probe.mjs
experiments/edges.mjs
experiments/macros.mjs
experiments/probe.mjs
experiments/seam.mjs
experiments/seam2.mjs
experiments/todo-nomacro.mjs
experiments/shadow-probe/probe-advanced.cjs
experiments/shadow-probe/.shadow-cljs/
experiments/shadow-probe/experiments/
experiments/shadow-probe/node_modules/
squint.edn

# npm pack output (y9d.1 publishable-package build artifact)
tambor-*.tgz

# benchmark harness raw-JSON results (tambor-54j.4): machine-generated
# per-run artifacts, regenerated by `npm run bench`; the harness and
# schema are the tracked source, the numbers are reproducible output
benchmarks/results/
/test-results/

# npm publish tarballs (scoped name)
charly-vibes-tambor-*.tgz

# HITL screenshots are local dev artifacts (tambor-kd5) — regenerated by
# every e2e run; platform fonts make committed baselines pure git noise.
tests/screenshots/
