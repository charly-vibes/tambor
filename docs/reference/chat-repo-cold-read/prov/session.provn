document
  prefix ex <urn:example:tambor-wanna-session#>
  prefix prov <http://www.w3.org/ns/prov#>

  agent(ex:user,    [prov:type='prov:Person'])
  agent(ex:claude,  [prov:type='prov:SoftwareAgent'])
  agent(ex:sandbox, [prov:type='prov:SoftwareAgent'])
  agent(ex:web,     [prov:type='prov:SoftwareAgent'])
  agent(ex:publish, [prov:type='prov:SoftwareAgent'])

  entity(ex:tambor_zip)
  entity(ex:wanna_zip)
  entity(ex:power_turtle_zip)
  entity(ex:power_turtle_com_shell)
  entity(ex:power_turtle_repo_page)
  entity(ex:demo1_html)
  entity(ex:demo1_url)
  entity(ex:demo2_html)
  entity(ex:demo2_url)
  entity(ex:repo)

  wasAttributedTo(ex:tambor_zip, ex:user)
  wasAttributedTo(ex:wanna_zip, ex:user)
  wasAttributedTo(ex:power_turtle_zip, ex:user)

  activity(ex:A01, -, -, [prov:label='read tambor and wanna'])
  activity(ex:A02, -, -, [prov:label='build demo 1'])
  activity(ex:A03, -, -, [prov:label='publish demo 1 with fix'])
  activity(ex:A06, -, -, [prov:label='build demo 2'])
  activity(ex:A07, -, -, [prov:label='test and publish demo 2'])
  activity(ex:A10, -, -, [prov:label='fetch power-turtle.com'])
  activity(ex:A11, -, -, [prov:label='fetch power-turtle repo page'])
  activity(ex:A12, -, -, [prov:label='analyse power-turtle zip'])
  activity(ex:A14, -, -, [prov:label='generate this repo'])

  wasAssociatedWith(ex:A01, ex:claude, -)
  wasAssociatedWith(ex:A02, ex:claude, -)
  wasAssociatedWith(ex:A03, ex:publish, -)
  wasAssociatedWith(ex:A06, ex:claude, -)
  wasAssociatedWith(ex:A07, ex:sandbox, -)
  wasAssociatedWith(ex:A10, ex:web, -)
  wasAssociatedWith(ex:A11, ex:web, -)
  wasAssociatedWith(ex:A12, ex:claude, -)
  wasAssociatedWith(ex:A14, ex:claude, -)

  used(ex:A01, ex:tambor_zip, -)
  used(ex:A01, ex:wanna_zip, -)
  used(ex:A02, ex:tambor_zip, -)
  used(ex:A02, ex:wanna_zip, -)
  used(ex:A06, ex:tambor_zip, -)
  used(ex:A12, ex:power_turtle_zip, -)

  wasGeneratedBy(ex:demo1_html, ex:A02, -)
  wasGeneratedBy(ex:demo1_url, ex:A03, -)
  wasGeneratedBy(ex:demo2_html, ex:A06, -)
  wasGeneratedBy(ex:demo2_url, ex:A07, -)
  wasGeneratedBy(ex:power_turtle_com_shell, ex:A10, -)
  wasGeneratedBy(ex:power_turtle_repo_page, ex:A11, -)
  wasGeneratedBy(ex:repo, ex:A14, -)

  wasDerivedFrom(ex:demo1_html, ex:wanna_zip)
  wasDerivedFrom(ex:demo1_html, ex:tambor_zip)
  wasDerivedFrom(ex:demo2_html, ex:demo1_html)
  wasDerivedFrom(ex:demo2_html, ex:tambor_zip)
  wasDerivedFrom(ex:repo, ex:demo1_html)
  wasDerivedFrom(ex:repo, ex:demo2_html)

  entity(ex:tambor_zip_v2)
  entity(ex:membrane_sources)
  entity(ex:notebook_html)
  entity(ex:notebook_url)
  wasAttributedTo(ex:tambor_zip_v2, ex:user)

  activity(ex:A15, -, -, [prov:label='diff updated tambor'])
  activity(ex:A16, -, -, [prov:label='verify emit and logo parity'])
  activity(ex:A17, -, -, [prov:label='design benchmark programme'])
  activity(ex:A18, -, -, [prov:label='investigate membrane'])
  activity(ex:A20, -, -, [prov:label='build and test notebook'])
  activity(ex:A21, -, -, [prov:label='publish notebook'])
  activity(ex:A22, -, -, [prov:label='update repository'])

  wasAssociatedWith(ex:A15, ex:claude, -)
  wasAssociatedWith(ex:A16, ex:sandbox, -)
  wasAssociatedWith(ex:A17, ex:claude, -)
  wasAssociatedWith(ex:A18, ex:web, -)
  wasAssociatedWith(ex:A20, ex:claude, -)
  wasAssociatedWith(ex:A21, ex:publish, -)
  wasAssociatedWith(ex:A22, ex:claude, -)

  used(ex:A15, ex:tambor_zip, -)
  used(ex:A15, ex:tambor_zip_v2, -)
  used(ex:A16, ex:tambor_zip_v2, -)
  used(ex:A17, ex:tambor_zip_v2, -)
  used(ex:A20, ex:tambor_zip_v2, -)
  used(ex:A22, ex:membrane_sources, -)

  wasGeneratedBy(ex:membrane_sources, ex:A18, -)
  wasGeneratedBy(ex:notebook_html, ex:A20, -)
  wasGeneratedBy(ex:notebook_url, ex:A21, -)

  wasDerivedFrom(ex:notebook_html, ex:tambor_zip_v2)
  wasDerivedFrom(ex:notebook_html, ex:demo2_html)
  wasDerivedFrom(ex:repo, ex:notebook_html)
  wasDerivedFrom(ex:repo, ex:membrane_sources)
  wasDerivedFrom(ex:repo, ex:tambor_zip_v2)
endDocument
