{
  "name": "tambor",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Strict-TypeScript, mobile-first UI library \u2014 specodelic corpus port of membrane",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./spa": {
      "types": "./dist/spa/mount.d.ts",
      "import": "./dist/spa/mount.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "build:spa": "esbuild src/spa/main.ts --bundle --format=esm --outfile=dist/spa.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "jest-junit": "^17.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
