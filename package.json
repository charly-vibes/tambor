{
  "name": "@charly-vibes/tambor",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Strict-TypeScript, mobile-first UI library \u2014 specodelic corpus port of membrane",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charly-vibes/tambor.git"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./spa": {
      "types": "./dist/spa/mount.d.ts",
      "import": "./dist/spa/mount.js"
    },
    "./dom": {
      "types": "./dist/dom.d.ts",
      "import": "./dist/dom.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "bench": "node benchmarks/run.mjs",
    "build": "tsc -p tsconfig.build.json",
    "build:spa": "node scripts/build-spa.mjs",
    "lint": "eslint .",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fast-check": "^4.10.2",
    "jest-junit": "^17.0.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "@playwright/test@1.64.1": true,
    "esbuild@0.28.2": true
  }
}
